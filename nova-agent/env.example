# Nova environment variables
NOVA_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# OPENAI_API_KEY=replace-me
NOVA_MODEL=deepseek-chat
NOVA_MAX_STEPS=25
NOVA_MAX_TOOL_OUTPUT=8000
NOVA_TOOL_TIMEOUT_MS=60000
NOVA_SAVE_REPORT=1

# Existing native connectors
# GITHUB_TOKEN=replace-me
# STRIPE_SECRET_KEY=sk_test_replace-me
CLAWDBOT_CLI=openclaw

# --- Shared Composio connector (server-side only) -----------------------------
# Get a key at https://app.composio.dev → API Keys → Create. One key enables
# every connected app (GitHub, Stripe, Slack, Gmail, ...). Sessions are scoped
# to COMPOSIO_USER_ID.
# COMPOSIO_API_KEY=replace-me
COMPOSIO_USER_ID=nova-user

# --- Automation connectors (server-side only) ---------------------------------
# Each needs an authorized webhook URL from the provider. Nova POSTs JSON to
# them and never exposes these values to the browser. After adding any value,
# verify it with:   node dist/index.js --verify-connectors
#
# ZAPIER_WEBHOOK_URL — app.zapier.com → Create Zap → trigger
#   "Webhooks by Zapier" → "Catch Hook" → copy the
#   https://hooks.zapier.com/hooks/catch/... URL → turn the Zap ON.
# ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
#
# N8N_WEBHOOK_URL — app.n8n.cloud → new workflow → add a "Webhook" trigger →
#   (optional) set "Header Auth" → activate the workflow → copy the PRODUCTION
#   URL (https://your-instance.n8n.cloud/webhook/...), NOT the test URL.
# N8N_WEBHOOK_URL=https://your-instance.n8n.cloud/webhook/...
# N8N_API_KEY=replace-me            # header value if you enabled Header Auth
#
# MAKE_WEBHOOK_URL — make.com → new scenario → "Webhooks" → "Custom webhook" →
#   copy the https://hook.eu1.make.com/... URL → toggle the scenario ON.
#   (A new webhook must receive one POST to be confirmed — Nova's ping does it.)
# MAKE_WEBHOOK_URL=https://hook.eu1.make.com/...

# --- Hugging Face (server-side only) ------------------------------------------
# Get an access token at https://huggingface.co/settings/tokens (create a new
# token with read + inference scopes). One token unlocks the Hugging Face Hub
# search (no key needed) and the OpenAI-compatible Inference API:
#   node dist/index.js --verify-connectors   (pings the token)
# The agent tool `huggingface` supports: ping | models <query> | infer <prompt>
# HUGGINGFACE_TOKEN=replace-me

NOVA_BROWSER_HEADLESS=1
PORT=3000
# NOVA_MOCK=1

# --- Connector self-check (UI server) ----------------------------------------
# The Nova UI server automatically pings configured connectors (Composio,
# Zapier, n8n, Make, Hugging Face) on this cadence and surfaces the result in the
# dashboard's Connectors view and /api/health. Set to 0 to disable the
# schedule (manual "Run verification now" / /api/connectors/verify still work).
NOVA_CONNECTOR_CHECK_HOURS=24

# --- Credential vault (encrypted key storage) --------------------------------
# Nova stores API keys and webhook URLs encrypted at rest (AES-256-GCM) in
# <NOVA_VAULT_DIR|./vault>/keys.json. Use it from the CLI, the dashboard's
# Vault view, or the agent's `vault` tool. Connector values stored under their
# env-var names (ZAPIER_WEBHOOK_URL, N8N_WEBHOOK_URL, MAKE_WEBHOOK_URL,
# COMPOSIO_API_KEY, GITHUB_TOKEN, STRIPE_SECRET_KEY, HUGGINGFACE_TOKEN) are picked up
# automatically when the env var is not set.
#   node dist/index.js --vault set ZAPIER_WEBHOOK_URL https://...
#   node dist/index.js --vault list
# NOVA_VAULT_KEY=replace-me   # optional master key; otherwise a random key is
#                             # created at vault/.master.key on first use
# NOVA_VAULT_DIR=./vault      # optional storage directory

# --- Daily report email (Nova-generated) -------------------------------------
# Nova builds a daily text report (connector health + task stats) and POSTs it
# to a webhook that emails it to you. Recommended Zapier setup: change the Zap
# trigger to "Webhooks by Zapier → Catch Hook" (free plan supports it), map the
# email Subject/Body to the payload's `subject` / `body` fields, then set
# ZAPIER_WEBHOOK_URL to the new hook URL (see the automation section above).
# Test the email anytime with:   node dist/index.js --report
NOVA_DAILY_REPORT=1            # 1/0 — master switch (default enabled)
# NOVA_DAILY_REPORT_TIME=09:00 # local time the report fires (default 09:00)
# NOVA_REPORT_PROVIDER=zapier  # zapier | make | n8n (default: first configured webhook)

# --- Jobs (autonomous multi-step tasks) ---------------------------------------
# Nova runs multi-step jobs from JSON files ({ "name": ..., "task": "..." })
# with every tool available (web search, vault, automations, ...):
#   node dist/index.js --job jobs/connect-zapier.example.json
# The example job collects a Zapier Catch Hook URL, stores it in the vault,
# verifies it, and sends a confirmation email — the same kind of setup job
# Nova can run for n8n and Make.
