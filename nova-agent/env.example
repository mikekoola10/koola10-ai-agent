# ============================================================
# Nova — environment variables (copy to .env and fill in)
# ============================================================

# ---- Model provider (choose one) ----
# deepseek   -> needs DEEPSEEK_API_KEY   (default; cheap, tool-calling capable)
# anthropic  -> needs ANTHROPIC_API_KEY  (Claude — same family as Clawdbot/OpenClaw)
# openai     -> needs OPENAI_API_KEY
NOVA_PROVIDER=deepseek

# API key for the active provider:
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Model name (per-provider defaults are used if unset):
#   deepseek: deepseek-chat | openai: gpt-4o-mini | anthropic: claude-sonnet-4-5
NOVA_MODEL=deepseek-chat

# API base (leave as-is unless you use a proxy or another OpenAI-compatible host)
# NOVA_API_BASE=https://api.deepseek.com

# Max agent loop iterations (bounds cost/time on long tasks)
NOVA_MAX_STEPS=25

# Max characters each tool result may feed back to the model
NOVA_MAX_TOOL_OUTPUT=8000

# Timeout (ms) for shell commands executed by the agent
NOVA_TOOL_TIMEOUT_MS=60000

# Save the final report to output/last-report.md (1 = yes, 0 = no)
NOVA_SAVE_REPORT=1

# ---- Connectors (optional, enable the github / stripe / clawdbot tools) ----
# GitHub token: https://github.com/settings/tokens (fine-grained tokens work best)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Stripe secret key (use sk_test_ for testing, sk_live_ only when you intend real charges)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Clawdbot (OpenClaw) CLI binary — install with `npm install -g openclaw`
CLAWDBOT_CLI=openclaw

# ---- Browser & computer use (optional tools) ----
# Browser tool needs:  npm install playwright && npx playwright install chromium
# Run the browser headless (1) or headed (0)
NOVA_BROWSER_HEADLESS=1

# Computer use tool needs xdotool + an X display on the machine Nova runs on:
#   sudo apt-get install -y xdotool
#   export DISPLAY=:0   (or run under Xvfb on headless servers)

# ---- Nova UI (nova-ui / npm run ui) ----
# Port for the Manus-style web interface. Binds 0.0.0.0. Freebuff preview injects PORT.
PORT=3000

# ---- Misc ----
# Run without an API key using a scripted mock brain (for testing the loop)
# NOVA_MOCK=1
